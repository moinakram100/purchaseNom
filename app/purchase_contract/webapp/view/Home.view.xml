<mvc:View
    controllerName="com.ingenx.purchasecontract.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
>
    <OverflowToolbar
        id="purchaseContractTb"
        height="50px"
    >
        <Title
            id="purchaseContractTitle"
            text="Purchase Agreement Panel"
            textAlign="Center"
        />
    </OverflowToolbar>
    <Page
        id="purchaseContractPage"
        showHeader="false"
    >
        <content>
            <GenericTile
                id="purchaseContractCreatePATile"
                class="sapUiSmallMarginBegin sapUiSmallMarginTop tileLayout"
                header="Create Gas Purchase Agreement"
                press="onCreatePA"
            >
                <TileContent id="purchaseContractCreatePATileContent">
                    <ImageContent
                        id="purchaseContractCreatPAImage"
                        src="sap-icon://decision"
                    />
                </TileContent>
            </GenericTile>

            <GenericTile
                id="_IDGenGenericTile2"
                class="sapUiSmallMarginBegin sapUiSmallMarginTop tileLayout"
                header="Amend Gas Purchase Agreement"
                press="onAmendPA"
            >
                <TileContent id="purchaseContractAmendPATileContent">
                    <ImageContent
                        id="purchaseContractCreatPAImage2"
                        src="sap-icon://edit"
                    />
                </TileContent>
            </GenericTile>

            <GenericTile
                id="_IDGenGenericTile3"
                class="sapUiSmallMarginBegin sapUiSmallMarginTop tileLayout"
                header="Display Gas Purchase Agreement"
                press="onDisplayPA"
            >
                <TileContent id="purchaseContractdisplayagreementPATileContent">
                    <ImageContent
                        id="purchaseContractCreatPAImage3"
                        src="sap-icon://manager-insight"
                    />
                </TileContent>
            </GenericTile>
        </content>
    </Page>
</mvc:View>