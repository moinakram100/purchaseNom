<mvc:View
    controllerName="com.ingenx.purchasecontract.controller.CreatePurchaseContract"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    busyIndicatorDelay="0"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:tnt="sap.tnt"
    xmlns:l="sap.ui.layout"
>
  <Page id="createContractPage" showHeader="false">

  <tnt:ToolHeader id="createContract_mainToolheaded" class="sapUiTinyMargin ">
            <Title id="createContract_Title_FieldDefinition" text="Create Contract" wrapping="true" level="H3" />
            <ToolbarSpacer id="createContract_ToolbarSpacer" />
    </tnt:ToolHeader>
  
<ScrollContainer id="createPC_ScrollContainer">
        <l:VerticalLayout id="createPurchase_VerticalLayout" width="100%">
            <l:BlockLayout id="createPurchase_BlockLayout" background="Dashboard">

             <l:BlockLayoutRow id="createPurchase_BlockLayoutRow3">
                    <l:BlockLayoutCell id="createPurchase_GenBlockLayoutCell3">
                    <HBox
                        id="createPurcHBox1"
                        class="sapUiTinyMarginTop selectArea"
                    >
                        <Label
                            id="create_docTypeLabel"
                            class="sapUiTinyMargin"
                            text="Document Type:"
                            design="Bold"
                        />
                            <Select
                                width="250px"
                                class="sapUiTinyMarginBottom sapUiTinyMarginBegin"
                                items="{docTypeModel>/}"
                                forceSelection="false"
                                selectedKey="{sales>/SalesContractType}"
                                id="selectedDocumentType"
                                change="docTypeSelection"
                            >
                                <core:Item
                                    key="{docTypeModel>DocumentNo}"
                                    text="{docTypeModel>DocumentNo}"
                                />
                            </Select>
                    </HBox>


            <IconTabBar
                id="iconTabBarHeader"
                class="sapUiSmallMarginTop sapUiSmallMarginBottom selectArea selectArea2"
                select="onSelectoptions"
                visible="false"
            >
                <items>
                    <IconTabFilter
                        id="create_orgDetailsIconTabFilter"
                        text="Org Details"
                        key="headerDetails"
                        icon="sap-icon://header"
                        class="sapUiTinyMargin"
                    >
                        <form:SimpleForm
                            id="create_orgDetailsForm"
                            class="sapUiTinyMargin formArea"
                            editable="true"
                        >
                            <form:toolbar>
                                <Toolbar id="TB1">
                                    <Title
                                        id="Title1"
                                        text="Org Details"
                                    />
                                    <ToolbarSpacer id="TBS1" />
                                    <Button
                                        id="capDetailsBtn"
                                        text="NEXT" type="Emphasized"
                                        width="100px"
                                        press="onNext"
                                    />
                                </Toolbar>
                            </form:toolbar>
                            <form:content>
                                <core:Title id="create_IDGenTitle1" />
                                <VBox id="orgDetailsContainer" class="dynamicField"/>
                                <Label
                                    id="create_vendorLabel"
                                    text="Vendor" 
                                    required="true"
                                    labelFor="create_VendorId"
                                    visible="false"
                                />
                                <HBox id="createPurcHBox2">
                                    <Input
                                        id="create_VendorId"
                                        width="200px"
                                        showValueHelp="true"
                                        valueHelpRequest="onVendorValueHelp"
                                        value="{purchase>/Vendor}"
                                        visible="false" 
                                    />
                                    <Input
                                        id="vendorDesc"
                                        width="200px"
                                        editable="false"
                                        visible="false"
                                        class="sapUiTinyMarginBegin"
                                    />
                                </HBox>
                                <Label
                                    id="create_companyCodeLabel"
                                    text="Company Code"
                                    visible="false"
                                />
                                <HBox id="createPurcHBox3">
                                    <Input
                                        id="companyCode_id"
                                        width="200px"
                                        editable="false"
                                        value="{vendorDataModel>/CompanyCode}"
                                        visible="false"
                                    />
                                    <Input
                                        id="companyDesc"
                                        width="200px"
                                        editable="false"
                                        visible="false"
                                        class="sapUiTinyMarginBegin"
                                        value="{vendorDataModel>/PurchasingOrganizationName}"
                                    />
                                </HBox>
                                <Label
                                    id="create_purchaseOrgLabel"
                                    text="Purchase Organisation"
                                    visible="false"
                                />
                                <HBox id="createPurcHBox4">
                                    <Input
                                        id="purchaseOrg_id"
                                        width="200px"
                                        editable="false"
                                        visible="false"
                                        value="{vendorDataModel>/PurchasingOrganization}"
                                    />
                                    <Input
                                        id="purchOrgDesc"
                                        width="200px"
                                        editable="false"
                                        visible="false"
                                        class="sapUiTinyMarginBegin"
                                        value="{vendorDataModel>/PurchasingOrganizationName}"
                                    />
                                </HBox>
                                <core:Title id="create_IDGenTitle2" />
                                <VBox id="orgDetailsContainer2" class="dynamicFieldRight"/>
                                <Label
                                    id="create_purchaseGroupLabel"
                                    text="Purchase Group"
                                    required="true"
                                    visible="false"
                                />
                                <HBox id="createPurcHBox5">
                                    <Input
                                        id="purchase_id"
                                        width="200px"
                                        showValueHelp="true"
                                        valueHelpRequest="onPurchaseGroupValueHelp"
                                        value="{purchase>/PurGroup}"
                                        visible="false"
                                    />
                                    <Input
                                        id="purchGrpDesc"
                                        width="200px"
                                        editable="false"
                                        visible="false"
                                        class="sapUiTinyMarginBegin"
                                    />
                                </HBox>
                                <Label
                                    id="create_startDateLabel"
                                    text="Start Date"
                                    visible="false"
                                />
                                <DatePicker
                                    id="create_startDate"
                                    placeholder="‎"
                                    change="onSelectDate"
                                    width="200px"
                                    required="true"
                                    ariaLabelledBy=""
                                    visible="false"
                                />
                                <Label
                                    id="create_endDateLabel"
                                    text="End Date"
                                    visible="false"
                                    
                                />
                                <DatePicker
                                    id="create_endDate"
                                    placeholder="‎"
                                    change="onSelectDate"
                                    width="200px"
                                    required="true"
                                    visible="false"
                                />
                            </form:content>
                        </form:SimpleForm>
                    </IconTabFilter>
                    <IconTabFilter
                        id="capacityRelIconTabFilter"
                        key="itemDetails"
                        text="Capacity Details"
                        icon="sap-icon://activity-items"
                        enabled="false"
                    >
                             
                        <form:SimpleForm
                            id="create_capRelSimpleForm"
                            class="formArea sapUiTinyMargin"
                            editable="true"
                        >
                            <form:toolbar>
                                <Toolbar id="TB2">
                                    <Title
                                        id="Title2"
                                        text="Capacity Details"
                                    />
                                    <ToolbarSpacer id="_IDGen" />
                              
                                    <Button
                                        id="servCatalogBtn"
                                        text="NEXT" type="Emphasized"
                                        visible="true"
                                        press="onProceedServCat"
                                        width="100px"
                                        ariaHasPopup="Dialog"
                                    />
                                </Toolbar>
                            </form:toolbar>
                            <form:content >
                                <core:Title id="create_Title5" />
                                <HBox id="capacityReleaseContainer" class="dynamicField"/>
                                <Label
                                    id="Create_materialLabel"
                                    text="Material"
                                    required="true"
                                    visible="false"
                                />
                                <HBox id="materialBox">
                                    <Input
                                        id="material_id"
                                        width="200px"
                                        showValueHelp="true"
                                        valueHelpRequest="onMaterialValueHelp"
                                        value=""
                                        visible="false"
                                    />
                                    <Input
                                        id="materialDesc"
                                        width="200px"
                                        editable="false"
                                        visible="false"
                                        class="sapUiTinyMarginBegin"
                                    />
                                </HBox>

                                 <Label
                                    id="create_dcqLabel"
                                    text="DCQ"
                                    visible="true"
                                />
                                <Input
                                    id="DCQ_Input"
                                    width="200px"
                                    required="true"
                                    liveChange="deriveNetDCQ"
                                    visible="true"
                                />

                                <Label
                                    id="create_targetQtyLabel"
                                    text="Target Quantity" 
                                    visible="false"
                                />
                                <Input
                                    id="targetQuantity"
                                    width="200px"
                                    editable="false"
                                    change="targetQuantityCal"
                                    busy="false"
                                    visible="false"
                                />
                                <Label
                                    id="create_uomLabel"
                                    text="UOM"
                                    visible="false"
                                />
                                <Input
                                    id="Uom_id"
                                    width="200px"
                                    showValueHelp="true"
                                    valueHelpRequest="onUomValueHelp"
                                    value=""
                                    required="true"
                                    visible="false"
                                />
                                <core:Title id="create_Title4" />
                                    <HBox id="capacityReleaseContainerRight" class="dynamicField"/>
                                <Label
                                    id="create_plantLlabel"
                                    text="Plant"
                                    required="true"
                                    visible="false"
                                />
                                <HBox id="createPurcHBox6">
                                    <Input
                                        id="plant_id"
                                        width="200px"
                                        showValueHelp="true"
                                        valueHelpRequest="onPlantValueHelp"
                                        value=""
                                        required="true"
                                        visible="false"
                                    />
                                    <Input
                                        id="plantDesc"
                                        width="200px"
                                        editable="false"
                                        visible="false"
                                        class="sapUiTinyMarginBegin"
                                    />
                                </HBox>
                                <Label
                                    id="create_storageLocLabel"
                                    text="Storage Location"
                                    visible="false"
                                />
                                <HBox id="createPurcHBox7">
                                    <Input
                                        id="storage_id"
                                        width="200px"
                                        showValueHelp="true"
                                        valueHelpRequest="onStorageValueHelp"
                                        value=""
                                        required="true"
                                        visible="false"
                                    />
                                    <Input
                                        id="storageDesc"
                                        width="200px"
                                        editable="false"
                                        visible="false"
                                        class="sapUiTinyMarginBegin"
                                    />
                                </HBox>
                                <Label
                                    id="create_serviceProfileLabel"
                                    text="Service Profile"
                                    class="servProLabel"
                                    required="true"
                                    visible="false"
                                />
                            <HBox id="createPurcHBox8" class="sapUiSmallMarginEnd">
                                <Select
                                    width="200px"
                                    change="onSelectProfile"
                                    items="{servicParamModel>/}"
                                    id="selectedProfileType"
                                    forceSelection="false"
                                    visible="false"
                                >
                                    <core:Item  key="{servicParamModel>serviceProfileName}" text="{servicParamModel>serviceProfileName}" />
                                </Select>
                                <Input id="servProDesc" class="sapUiTinyMarginBegin" visible="false" editable="false" width="200px" />
                            </HBox>
                                
                               <Label
                                                id="Delivery"
                                                wrapping="true"
                                                text="Delivery Point"
                                                required="true"
                                                visible="true"
                                />
                                <HBox id="createPurcHBox9">
                                    <Input
                                        id="delivery_id"
                                        width="200px"
                                        showValueHelp="true"
                                        valueHelpRequest="onDeliveryValueHelp"
                                        value=""
                                        required="true"
                                        visible="true"
                                    />
                                    <Input
                                        id="delivery_Desc"
                                        width="200px"
                                        editable="false"
                                        visible="false"
                                        class="sapUiTinyMarginBegin"
                                    />
                                </HBox>
                              </form:content>
                        </form:SimpleForm>
                    </IconTabFilter>
                    <IconTabFilter
                        id="serviceCatalogueIconTabFilter"
                        text="Service Catalogue"
                        icon="sap-icon://crm-service-manager"
                        key="servDetails"
                        class="iconText"
                        enabled="false"
                    >

                        <Table
                            id="create_paramTable"
                            items="{contractDataModel>/}"
                            mode="None"
                            class="formArea sapUiTinyMargin"
                            visible="false"
                        >
                            <columns>
                                <Column id="create_paramTableCol" width="7rem">
                                    <header>
                                        <Title
                                            id="create_paramTableTitle"
                                            text="Service Parameter"
                                        />
                                    </header>
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem id="create_paramTableListitem">
                                    <cells>
                                        <Text id="create_serviceParamvalueText" text="{contractDataModel>serviceParameter}" />
                                        <Text
                                            text="{contractDataModel>ID}"
                                            visible="false"
                                            id="create_ParamIdText"
                                        />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                        <Table
                            items="{valueParameterModel>/}"
                            mode="None"
                            id="valueParameterTable"
                            class="formArea sapUiTinyTop"
                        >
                            <columns>
                                <Column width="10rem" id="valueParameterCol">
                                    <header>
                                        <Label
                                            id="valueParameterLabel"
                                            text="Value Parameter"
                                        />
                                    </header>
                                </Column>
                                <Column width="10rem" id="valueCol">
                                    <header>
                                        <Label
                                            id="valueLabel"
                                            text="Value"
                                        />
                                    </header>
                                </Column>
                                <Column width="40rem" id="valueColitem">
                                    <header>
                                        <Title id="title6" />
                                    </header>
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem id="create_valueparamTableListitem">
                                    <cells>
                                        <Text id="create_serviceParamText" text="{valueParameterModel>serviceParameter}" />
                                        <Input
                                            id="create_valueParamInput"
                                            width="100px"
                                            value="{valueParameterModel>value}"
                                            change="tarQuantCalCatlog"
                                            required="true"
                                        />
                                        <Label
                                            id="uomUnitDerived"
                                            text="{valueParameterModel>uom}"
                                            
                                        />
                                        <Text
                                            text="{valueParameterModel>ID}"
                                            visible="false"
                                        />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                        <VBox id="_IDGenVBox6">
                            <Button
                                text="Add Clause Code"
                                press="onAddClauseCodePress"
                                class="sapUiTinyMarginTop"
                                type="Emphasized"
                            />
                            <Table
                                items="{threshDataModel>/}"
                                id="clCodeTable"
                                class="formArea sapUiTinyMargin"
                            >
                                <columns>
                                    <Column id="create_clClauseCodeCol" hAlign="Center">
                                        <Text id="create_clClauseCodeText" text="Clause Code" />
                                    </Column>
                                    <Column id="create_clValidFromCol" hAlign="Center">
                                        <Text id="create_clValidFromText" text="Valid From" />
                                    </Column>
                                    <Column id="create_clvalidToCol" hAlign="Center">
                                        <Text id="create_clvalidToText" text="Valid To" />
                                    </Column>
                                    <Column id="create_clThreshholdCol" hAlign="Center">
                                        <Text id="create_clThreshholdText" text="Threshold%" />
                                    </Column>
                                    <Column id="create_clThresholdRefCol" hAlign="Center">
                                        <Text id="create_clThresholdRefText" text="Threshold Reference" />
                                    </Column>
                                    <Column id="create_clRemarkCol" hAlign="Center">
                                        <Text id="create_clRemarkText" text="Remark" />
                                    </Column>
                                    <Column id="create_clActionCol" hAlign="Center">
                                        <Text id="create_clActionText" text="Action" />
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="clCodeListItem">
                                        <cells>
                                            <Select 
                                                id="clauseCodSelectItem"
                                                width="150px"
                                                items="{ThresholdRelevantModel>/}"
                                                selectedKey="{threshDataModel>clCode}"
                                                forceSelection="false"
                                            >
                                                <core:Item
                                                    id="clauseCodSelectItems"
                                                    key="{ThresholdRelevantModel>serviceParameter}"
                                                    text="{ThresholdRelevantModel>serviceParameter}"
                                                />
                                            </Select>
                                            <DatePicker
                                                id="clauseCodeValidFrom"
                                                width="150px"
                                                value="{threshDataModel>validFrom}"
                                                change="onSelectClauseCValidFrom"
                                                required="true"
                                            />
                                            <DatePicker
                                                id="clauseCodeValidTo"
                                                width="150px"
                                                value="{threshDataModel>validTo}"
                                                change="onSelectClauseCValidTo"
                                                required="true"
                                            />
                                            <Input
                                                id="clCodeThresholdValue"
                                                width="150px"
                                                value="{threshDataModel>threshold}"
                                            />
                                            <Select
                                                id="clCodeThreshRefSelectItem"
                                                width="150px"
                                                items="{RefrenceRelevantModel>/}"
                                                selectedKey="{threshDataModel>threshRef}"
                                                forceSelection="false"
                                            >
                                                <core:Item
                                                   id="clCodeThreshRefSelectItems"
                                                    key="{RefrenceRelevantModel>serviceParameter}"
                                                    text="{RefrenceRelevantModel>serviceParameter}"
                                                />
                                            </Select>
                                            <Input
                                                id="clcodeRemark"
                                                width="150px"
                                                value="{threshDataModel>remark}"
                                                required="true"
                                            />
                                            <Button id="actionBtn" icon="sap-icon://delete" press="onDeleteClauseCodePress" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                            <Table
                                id="allocTable"
                                items="{allocModel>/allocLevel}"
                                class="formArea sapUiTinyMarginTop"
                            >
                                <headerToolbar>
                                    <Toolbar id="create_allocTableTB">
                                        <Title id="create_allocTableTitle" text="Allocation Parameters" />
                                    </Toolbar>
                                </headerToolbar>
                                <columns>
                                    <Column id="create_allocLevelCol">
                                        <Text id="create_allocLevelText" text="Level" />
                                    </Column>
                                    <Column id="create_allocParamCol">
                                        <Text id="create_allocParamText" text="Parameters" />
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="allocTableListItem">
                                        <cells>
                                            <Text id="allocTableLavel" text="{allocModel>Level}" />
                                            <Select
                                                id="allocTableParamSelect"
                                                selectedKey="{allocModel>selectedParam>/}"
                                                width="200px"
                                                forceSelection="false"
                                                items="{
                                                path: 'allocModel>Parameters',
                                                templateShareable: true
                                            }"
                                            >
                                           <core:Item key="{allocModel>key}" text="{allocModel>text}" />
                                                <!-- DYNAMIC ITEMS -->
                                            </Select>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                            <Button
                                id="_IDGenButton"
                                text="Submit"
                                width="100px"
                                class="sapUiTinyMarginTop"
                                type="Emphasized"
                                press="submitPurchaseAgreement"
                            />
                        </VBox>
                    </IconTabFilter>
                </items>
            </IconTabBar>
    
                    </l:BlockLayoutCell>
             </l:BlockLayoutRow>

              
           </l:BlockLayout>
        </l:VerticalLayout>
     </ScrollContainer>
     </Page>
</mvc:View>